# Copy to .env. Keys stay here on the server; never paste them into chat.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Each capability is independent. Use only a Subscription Key with verified benefits.
# io defaults are international. Mainland docs now list api.minimax.cn;
# api.minimaxi.com remains the compatible host successfully tested on 2026-10-17.
MINIMAX_KEY_TYPE=subscription
MINIMAX_VISION_ENABLED=false
MINIMAX_VISION_KEY=
MINIMAX_VISION_URL=https://api.minimax.io/v1/chat/completions
MINIMAX_VISION_MODEL=MiniMax-M3.1-Flash-Preview
MINIMAX_ASR_ENABLED=false
MINIMAX_ASR_KEY=
MINIMAX_ASR_URL=https://api.minimax.io/v1/speech_to_text
MINIMAX_ASR_MODEL=asr-1.0
MINIMAX_TTS_ENABLED=false
MINIMAX_TTS_KEY=
MINIMAX_TTS_URL=https://api.minimax.io/v1/t2a_v2
MINIMAX_TTS_MODEL=speech-2.8-turbo
# Candidate system voices: audition in video room before using for a session.
VOICE_CYBER_JUDGE_K07=Chinese (Mandarin)_Reliable_Executive
VOICE_SLACKING_SENIOR=Chinese (Mandarin)_Unrestrained_Young_Man
VOICE_MYSTIC_INTERVIEWER=Chinese (Mandarin)_Gentleman
VOICE_EMO_POET_HR=Chinese (Mandarin)_Gentle_Youth
VOICE_CHATTY_HOST=Chinese (Mandarin)_Humorous_Elder
PROVIDER_TIMEOUT_SECONDS=20
SESSION_TTL_SECONDS=7200
COOKIE_SECURE=false
